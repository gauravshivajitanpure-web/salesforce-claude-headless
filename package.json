{
  "name": "salesforce-headless-bridge",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "description": "Claude + Salesforce Headless 360 + Revenue Cloud bridge with React MCP App UI",
  "scripts": {
    "auth": "node --env-file=.env salesforce-auth.js",
    "build:ui": "cross-env INPUT=mcp-app.html vite build",
    "dev:ui": "cross-env NODE_ENV=development INPUT=mcp-app.html vite build --watch",
    "start": "npm run build:ui && node --env-file=.env server.js",
    "start:server": "node --env-file=.env server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
